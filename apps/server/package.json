{
  "name": "@leitura/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bun run db:generate:sqlite && bun run db:generate:pg",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:studio:sqlite": "drizzle-kit studio --config=drizzle.sqlite.config.ts",
    "db:studio:pg": "drizzle-kit studio --config=drizzle.pg.config.ts"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.16",
    "@leitura/common": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}